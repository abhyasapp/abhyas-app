{
  "name": "abhyas",
  "version": "1.48.0",
  "private": true,
  "description": "Abhyas: Loksewa Civil Engineering exam prep (static PWA + Apps Script backend)",
  "scripts": {
    "serve": "npx --yes serve -l 5500 .",
    "check-syntax": "node tools/check-syntax.mjs",
    "audit": "node tools/audit.mjs",
    "audit:handlers": "node tools/audit-handlers.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "verify": "npm run check-syntax && npm run lint && npm test",
    "audit:buttons": "node tools/audit-buttons.mjs",
    "sync-shell": "node tools/sync-shell.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5"
  }
}
